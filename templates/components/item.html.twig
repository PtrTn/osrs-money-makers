<p class="m-0">
    <img alt="{{ stack.item.examine }}" class="me-1" src="{{ stack.image }}"/>
    {% if not stack.item.isMoney %}
        {{ stack.quantity * recipe.throughput }} {% include 'components/item-link.html.twig' with {'item': stack.item } %}
        {% if type == 'buy' %}
            <span
                class="{{ stack.item.price.buyPriceStatus }}"
                {% if stack.item.price.hasHistoricData %}
                    data-bs-toggle="tooltip"
                    data-bs-title="Bought {{ stack.item.price.buyVolume|price }} times for prices between {{ stack.item.price.lowestBuyPrice }}ea and {{ stack.item.price.highestBuyPrice }}ea in the last week"
                {% endif %}
                >
                {{ stack.item.buyPrice }}ea
            </span>
        {% endif %}
        {% if type == 'sell' %}
            <span
                class="{{ stack.item.price.sellPriceStatus }}"
                {% if stack.item.price.hasHistoricData %}
                    data-bs-toggle="tooltip"
                    data-bs-title="Sold {{ stack.item.price.sellVolume|price }} times for prices between {{ stack.item.price.lowestSellPrice }}ea and {{ stack.item.price.highestSellPrice }}ea in the last week"
                {% endif %}
                >
                {{ stack.item.sellPrice }}ea
            </span>
        {% endif %}
    {% else %}
        {{ (stack.quantity * recipe.throughput)|price(2) }} {{ stack.item.name }} ({{ stack.quantity }}ea)
    {% endif %}
</p>