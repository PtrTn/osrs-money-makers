{% extends 'base.html.twig' %}

{% block title %}All items{% endblock %}

{% block body %}
    <!-- Header-->
    <header class="bg-dark py-5">
        <div class="container px-4 px-lg-5 my-5">
            <div class="text-center text-white">
                <h1 class="display-4 fw-bolder">OSRS money makers</h1>
                <p class="lead fw-normal text-white-50 mb-0">For current prices</p>
            </div>
        </div>
    </header>
    <!-- Section-->
    <section class="py-5" style="min-height: 72vh;">
        <div class="container px-4 px-lg-5 mt-5">
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="container">
                    <div class="row py-2">
                        <div class="col fw-bold"></div>
                        <div class="col fw-bold">Buy</div>
                        <div class="col fw-bold">Sell</div>
                        <div class="col-2 fw-bold">Profit</div>
                    </div>
                    {% for recipe in recipes %}
                        <div class="row py-2" data-bs-toggle="collapse" data-bs-target="#collapse{{ loop.index }}" role="button">
                            <div class="col fw-bold">{{ recipe.dish.item.name }}</div>
                            <div class="col">{{ recipe.input|price }}</div>
                            <div class="col">{{ recipe.output|price }}</div>
                            <div class="col-2">{{ recipe.avgProfit|price }}</div>
                        </div>
                        <div class="row py-2 collapse bg-light" id="collapse{{ loop.index }}">
                            <div class="col">
                                {{ recipe.throughput }} per hour
                            </div>
                            <div class="col">
                                {% for ingredient in recipe.ingredients %}
                                    {% include 'components/item.html.twig' with {'stack': ingredient, 'type': 'buy' } %}
                                {% endfor %}
                            </div>
                            <div class="col">
                                {% include 'components/item.html.twig' with {'stack': recipe.dish, 'type': 'sell' } %}
                            </div>
                            <div class="col-2">
                                {{ recipe.grandExchangeCut|price }} cut
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
    <!-- Footer-->
    <footer class="py-4 bg-dark">
        <div class="container"><p class="m-0 text-center text-white">Copyright &copy; Tetter Pon {{ "now"|date('Y') }}</p></div>
    </footer>
{% endblock %}
