{% extends 'base.html.twig' %}

{% block title %}All items{% endblock %}

{% block body %}
    <!-- Header-->
    <header class="bg-dark py-5">
        <div class="container px-4 px-lg-5 my-5">
            <div class="text-center text-white">
                <h1 class="display-4 fw-bolder">OSRS money makers</h1>
                <p class="lead fw-normal text-white-50 mb-0">For current prices</p>
            </div>
        </div>
    </header>
    <!-- Section-->
    <section class="py-5">
        <div class="container px-4 px-lg-5 mt-5">
            <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">
                <table class="table table-hover table-borderless">
                    <thead>
                    <tr>
                        <th scope="col"></th>
                        <th scope="col">Buy</th>
                        <th scope="col">Sell</th>
                        <th scope="col">Profit</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for recipe in recipes %}
                        <tr data-bs-toggle="collapse" data-bs-target="#collapse{{ loop.index }}" role="button">
                            <th scope="row">{{ recipe.dish.item.name }}</th>
                            <td>{{ recipe.input|price }}</td>
                            <td>{{ recipe.output|price }}</td>
                            <td>{{ recipe.avgProfit|price }}</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="p-0">
                                <div class="collapse" id="collapse{{ loop.index }}">
                                    <table class="table table-borderless table-light mb-0">
                                        <thead>
                                        <tr>
                                            <th class="text-secondary fw-normal">Inputs</th>
                                            <th class="text-secondary fw-normal">Outputs</th>
                                            <th class="text-secondary fw-normal">Cut</th>
                                            <th class="text-secondary fw-normal">Throughput</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr>
                                            <td>
                                                {% for ingredient in recipe.ingredients %}
                                                    {% if not loop.first %}<br>{% endif %}
                                                    {{ ingredient.quantity * recipe.throughput }} x {{ ingredient.item.name }} <img src="{{ imageBaseUrl }}{{ ingredient.item.gameId }}.gif"/> for {{ ingredient.item.avgPrice }}ea
                                                {% endfor %}
                                            </td>
                                            <td>
                                                {{ recipe.dish.quantity * recipe.throughput }} x {{ recipe.dish.item.name }}  <img src="{{ imageBaseUrl }}{{ recipe.dish.item.gameId }}.gif"/> for {{ recipe.dish.item.avgPrice }}ea
                                            </td>
                                            <td>{{ recipe.grandExchangeCut|price }}</td>
                                            <td>{{ recipe.throughput }} per hour</td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                                </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    <!-- Footer-->
    <footer class="py-4 bg-dark fixed-bottom">
        <div class="container"><p class="m-0 text-center text-white">Copyright &copy; Tetter Pon {{ "now"|date('Y') }}</p></div>
    </footer>
{% endblock %}
